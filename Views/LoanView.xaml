<UserControl x:Class="SarasaviLibrary.Views.LoanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{DynamicResource MaterialDesignPaper}"
             TextElement.Foreground="{DynamicResource MaterialDesignBody}">
    <Grid Margin="16">
        <materialDesign:Card MaxWidth="600" Margin="16" Padding="24" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="Loan Process" FontSize="22" FontWeight="Medium" Margin="0 0 0 24" HorizontalAlignment="Center"/>
                
                <TextBox x:Name="TxtUserNumber" materialDesign:HintAssist.Hint="Borrower User Number (e.g. M001)" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="0 8" />
                <Button Content="Check User Status" Margin="0 8 0 16" Click="BtnCheckUser_Click" Style="{StaticResource MaterialDesignOutlinedButton}"/>
                
                <TextBlock x:Name="TxtUserStatus" TextWrapping="Wrap" Margin="0 0 0 16" FontWeight="Bold"/>

                <TextBox x:Name="TxtCopyNumber" materialDesign:HintAssist.Hint="Book Copy Number (e.g. F 0001-1)" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="0 8" />
                <Button Content="Verify Copy &amp; Loan" Margin="0 24 0 0" Click="BtnLoan_Click" Height="40" FontSize="16"/>
                
                <TextBlock x:Name="TxtFeedback" Margin="0 16 0 0" HorizontalAlignment="Center" FontWeight="Bold" TextWrapping="Wrap"/>
            </StackPanel>
        </materialDesign:Card>
    </Grid>
</UserControl>
