@page
@model ReturnModel
@{
    ViewData["Title"] = "Return Book";
}

<!-- Page Header Bar -->
<div class="header-bar">
    <div class="page-title">
        <h1>Book Return Process</h1>
        <p>Process returned book copies. The system will automatically check if the title has outstanding reservation holds and guide you on catalog storage.</p>
    </div>
</div>

<!-- Standard Success Alert -->
@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="custom-alert success">
        <span class="custom-alert-icon">✓</span>
        <div class="custom-alert-content">
            <div class="custom-alert-title">Return Successful</div>
            <div class="custom-alert-desc">@Model.SuccessMessage</div>
        </div>
    </div>
}

<!-- High-Priority Amber Reservation Alert -->
@if (!string.IsNullOrEmpty(Model.ReservationAlert))
{
    <div class="custom-alert warning" style="animation: glow-pulse-warning 2s infinite; border-color: var(--color-warning); background: rgba(251, 191, 36, 0.15);">
        <span class="custom-alert-icon" style="font-size: 2rem; color: var(--color-warning);">✦</span>
        <div class="custom-alert-content">
            <div class="custom-alert-title" style="color: var(--color-warning); font-size: 1.2rem; font-weight: 800;">RESERVATION TRIGGERED (SET ASIDE)</div>
            <div class="custom-alert-desc" style="font-weight: 500; font-size: 1rem; color: #fff;">@Model.ReservationAlert</div>
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="custom-alert danger">
        <span class="custom-alert-icon">⚠</span>
        <div class="custom-alert-content">
            <div class="custom-alert-title">Return Rejected</div>
            <div class="custom-alert-desc">@Model.ErrorMessage</div>
        </div>
    </div>
}

<div class="dashboard-grid" style="grid-template-columns: 1.5fr 1fr; gap: 2rem;">
    <!-- Form Panel -->
    <div class="glass-panel">
        <div class="section-header" style="margin-bottom: 2rem; border-bottom: 1px solid var(--panel-border); padding-bottom: 1rem;">
            <h2>Register Return Transaction</h2>
        </div>

        <form method="post">
            <div class="form-grid" style="grid-template-columns: 1fr;">
                <!-- Book Copy Number -->
                <div class="form-group">
                    <label asp-for="CopyNumber" class="form-label"></label>
                    <input asp-for="CopyNumber" class="form-control" placeholder="e.g. S0001-2" />
                    <span asp-validation-for="CopyNumber" style="color: var(--color-danger); font-size: 0.8rem;"></span>
                    <small style="color: var(--text-muted); margin-top: 0.25rem;">Scan or type the copy serial key from the inside of the book cover.</small>
                </div>
            </div>

            <div style="display: flex; justify-content: flex-end; gap: 1rem; border-top: 1px solid var(--panel-border); padding-top: 1.5rem; margin-top: 2rem;">
                <button type="reset" class="btn btn-secondary">Clear Fields</button>
                <button type="submit" class="btn btn-primary" style="background: linear-gradient(135deg, var(--color-success) 0%, var(--color-primary) 100%); box-shadow: 0 4px 15px rgba(16, 185, 129, 0.35);">
                    Process Return & Check Holds
                </button>
            </div>
        </form>
    </div>

    <!-- Librarian Action advisory -->
    <div class="glass-panel" style="background: rgba(16, 185, 129, 0.03); border-color: rgba(16, 185, 129, 0.1);">
        <div class="section-header" style="margin-bottom: 1.5rem; border-bottom: 1px solid rgba(255,255,255,0.05); padding-bottom: 0.5rem;">
            <h2 style="color: var(--color-success); font-size: 1.15rem;">Return Sequence Guide</h2>
        </div>

        <ul style="list-style: none; display: flex; flex-direction: column; gap: 1rem; font-size: 0.9rem; color: var(--text-secondary);">
            <li style="display: flex; align-items: flex-start; gap: 0.5rem;">
                <span style="color: var(--color-success); font-weight: bold;">✔</span>
                <div>
                    <strong>Identify Copy:</strong> Locate the classification code and copy index suffix.
                </div>
            </li>
            <li style="display: flex; align-items: flex-start; gap: 0.5rem;">
                <span style="color: var(--color-success); font-weight: bold;">✔</span>
                <div>
                    <strong>Status Audit:</strong> The return resets the active borrower's loan record status to 'Returned' and marks the transaction return timestamp.
                </div>
            </li>
            <li style="display: flex; align-items: flex-start; gap: 0.5rem;">
                <span style="color: var(--color-success); font-weight: bold;">✔</span>
                <div>
                    <strong>Hold Check:</strong> If the book title has an active waiting queue, the copy will be locked into **'SetAside'** state.
                </div>
            </li>
            <li style="display: flex; align-items: flex-start; gap: 0.5rem;">
                <span style="color: var(--color-success); font-weight: bold;">✔</span>
                <div>
                    <strong>Librarian Action Required:</strong> In case of reservation holds, place the physical copy in the 'Reserved Shelf' and contact the oldest reserver immediately.
                </div>
            </li>
        </ul>
    </div>
</div>
