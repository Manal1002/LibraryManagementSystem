@page
@model IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<!-- Page Header Bar -->
<div class="header-bar">
    <div class="page-title">
        <h1>Sarasavi Library Dashboard</h1>
        <p>Welcome to the Library Management System portal. Here is a real-time overview of catalog records and activities.</p>
    </div>
    <div class="header-action">
        <a asp-page="/Borrow" class="btn btn-primary">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" style="margin-right: 4px;">
                <path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/>
            </svg>
            New Book Loan
        </a>
    </div>
</div>

<!-- Stats Counter Grid -->
<div class="stats-grid">
    <!-- Stat 1 -->
    <div class="stat-card">
        <div class="stat-icon primary">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                <path d="M4 6H2v14c0 1.1.9 2 2 2h14v-2H4V6zm16-4H8c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm0 14H8V4h12v12z"/>
            </svg>
        </div>
        <div class="stat-number">@Model.TotalBooks</div>
        <div class="stat-label">Unique Titles</div>
    </div>
    <!-- Stat 2 -->
    <div class="stat-card">
        <div class="stat-icon success">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 17h-2v-2h2v2zm2.07-7.75l-.9.92C13.45 12.9 13 13.5 13 15h-2v-.5c0-1.1.45-2.1 1.17-2.83l1.24-1.26c.37-.36.59-.86.59-1.41 0-1.1-.9-2-2-2s-2 .9-2 2H7c0-2.76 2.24-5 5-5s5 2.24 5 5c0 1.04-.42 1.99-1.07 2.75z"/>
            </svg>
        </div>
        <div class="stat-number">@Model.TotalCopies</div>
        <div class="stat-label">Total Copies</div>
    </div>
    <!-- Stat 3 -->
    <div class="stat-card">
        <div class="stat-icon secondary">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                <path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/>
            </svg>
        </div>
        <div class="stat-number">@Model.TotalUsers</div>
        <div class="stat-label">Registered Users</div>
    </div>
    <!-- Stat 4 -->
    <div class="stat-card">
        <div class="stat-icon warning">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"/>
            </svg>
        </div>
        <div class="stat-number">@Model.ActiveLoansCount</div>
        <div class="stat-label">Active Loans</div>
    </div>
    <!-- Stat 5 -->
    <div class="stat-card">
        <div class="stat-icon primary" style="background: rgba(168, 85, 247, 0.1); border-color: rgba(168, 85, 247, 0.2); color: var(--color-secondary);">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                <path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z"/>
            </svg>
        </div>
        <div class="stat-number" style="color: var(--color-secondary);">@Model.PendingReservationsCount</div>
        <div class="stat-label">Pending Holds</div>
    </div>
</div>

<!-- Dashboard Data Grids -->
<div class="dashboard-grid">
    <!-- Recent Loans Panel -->
    <div class="glass-panel">
        <div class="section-header">
            <h2>Recent Book Loans</h2>
            <a asp-page="/Borrow" class="btn btn-secondary" style="padding: 0.4rem 1rem; font-size: 0.8rem;">View Wizard</a>
        </div>
        
        <div class="data-table-container">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Copy Number</th>
                        <th>Book Title</th>
                        <th>Borrower</th>
                        <th>Due Date</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.RecentLoans.Count == 0)
                    {
                        <tr>
                            <td colspan="5" style="text-align: center; color: var(--text-muted); padding: 2rem;">
                                No recent loan transactions logged.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var loan in Model.RecentLoans)
                        {
                            <tr>
                                <td><strong style="color: var(--color-primary);">@loan.CopyNumber</strong></td>
                                <td>@loan.BookTitle</td>
                                <td>
                                    <div>@loan.MemberName</div>
                                    <small style="color: var(--text-muted);">@loan.MemberNumber</small>
                                </td>
                                <td>@loan.DueDate.ToString("yyyy-MM-dd")</td>
                                <td>
                                    @if (loan.Status == "Active")
                                    {
                                        <span class="badge warning">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge success">Returned</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Active Reservations Panel -->
    <div class="glass-panel">
        <div class="section-header">
            <h2>Outstanding Holds</h2>
            <a asp-page="/Reserve" class="btn btn-secondary" style="padding: 0.4rem 1rem; font-size: 0.8rem;">New Reservation</a>
        </div>

        <div class="data-table-container">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Book</th>
                        <th>Reserver</th>
                        <th>Date Reserved</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.ActiveReservations.Count == 0)
                    {
                        <tr>
                            <td colspan="3" style="text-align: center; color: var(--text-muted); padding: 2rem;">
                                No outstanding holds pending.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var res in Model.ActiveReservations)
                        {
                            <tr>
                                <td>
                                    <div style="font-weight: 600;">@res.BookTitle</div>
                                    <small style="color: var(--text-muted);">@res.BookAccession</small>
                                </td>
                                <td>
                                    <div>@res.MemberName</div>
                                    <small style="color: var(--text-muted);">@res.MemberNumber</small>
                                </td>
                                <td>@res.ReservedDate.ToString("yyyy-MM-dd")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
