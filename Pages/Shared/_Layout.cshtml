<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sarasavi Library</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="app-container">
        <!-- Sidebar Navigation -->
        <aside class="sidebar">
            <a href="/" class="brand">
                <div class="brand-icon">
                    <svg viewBox="0 0 24 24">
                        <path d="M12 3L1 9l11 6 9-4.91V17h2V9L12 3z"/>
                        <path d="M22 18.5c0-1.38-1.12-2.5-2.5-2.5h-15C3.12 16 2 17.12 2 18.5V21h20v-2.5z" opacity=".8"/>
                    </svg>
                </div>
                <span class="brand-text">Sarasavi Lib</span>
            </a>

            <ul class="nav-menu">
                <li class="nav-item @(ViewContext.RouteData.Values["page"]?.ToString() == "/Index" ? "active" : "")">
                    <a asp-page="/Index">
                        <!-- Home Icon -->
                        <svg viewBox="0 0 24 24"><path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/></svg>
                        <span class="nav-text">Dashboard</span>
                    </a>
                </li>
                <li class="nav-item @(ViewContext.RouteData.Values["page"]?.ToString() == "/Inquiry" ? "active" : "")">
                    <a asp-page="/Inquiry">
                        <!-- Search Icon -->
                        <svg viewBox="0 0 24 24"><path d="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg>
                        <span class="nav-text">Book Inquiry</span>
                    </a>
                </li>
                <li class="nav-item @(ViewContext.RouteData.Values["page"]?.ToString() == "/Borrow" ? "active" : "")">
                    <a asp-page="/Borrow">
                        <!-- Borrow Icon -->
                        <svg viewBox="0 0 24 24"><path d="M19 3h-4.18C14.4 1.84 13.3 1 12 1s-2.4.84-2.82 2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 0c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zm2 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z"/></svg>
                        <span class="nav-text">Loan Copy</span>
                    </a>
                </li>
                <li class="nav-item @(ViewContext.RouteData.Values["page"]?.ToString() == "/Return" ? "active" : "")">
                    <a asp-page="/Return">
                        <!-- Return Icon -->
                        <svg viewBox="0 0 24 24"><path d="M12.5 8c-2.65 0-5.05 1-6.9 2.6L2 7v9h9l-3.62-3.62c1.39-1.16 3.16-1.88 5.12-1.88 3.54 0 6.55 2.31 7.6 5.5l2.37-.78C21.08 11.03 17.15 8 12.5 8z"/></svg>
                        <span class="nav-text">Return Copy</span>
                    </a>
                </li>
                <li class="nav-item @(ViewContext.RouteData.Values["page"]?.ToString() == "/Reserve" ? "active" : "")">
                    <a asp-page="/Reserve">
                        <!-- Reserve Icon -->
                        <svg viewBox="0 0 24 24"><path d="M17 12c-2.76 0-5 2.24-5 5s2.24 5 5 5 5-2.24 5-5-2.24-5-5-5zm1.65 7.35L16.5 17.15V14h1v2.65l1.85 1.85-.7.85zM18 3h-3.18C14.4 1.84 13.3 1 12 1s-2.4.84-2.82 2H6c-1.1 0-2 .9-2 2v15c0 1.1.9 2 2 2h6.11c-.59-.57-1.07-1.25-1.42-2H6V5h3v2h6V5h3v6.11c.75.35 1.43.83 2 1.42V5c0-1.1-.9-2-2-2z"/></svg>
                        <span class="nav-text">Reservations</span>
                    </a>
                </li>
                <li class="nav-item @(ViewContext.RouteData.Values["page"]?.ToString() == "/RegisterBook" ? "active" : "")">
                    <a asp-page="/RegisterBook">
                        <!-- Add Book Icon -->
                        <svg viewBox="0 0 24 24"><path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/></svg>
                        <span class="nav-text">Register Book</span>
                    </a>
                </li>
                <li class="nav-item @(ViewContext.RouteData.Values["page"]?.ToString() == "/RegisterUser" ? "active" : "")">
                    <a asp-page="/RegisterUser">
                        <!-- Add User Icon -->
                        <svg viewBox="0 0 24 24"><path d="M15 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm-9-2V7H4v3H1v2h3v3h2v-3h3v-2H6zm9 4c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
                        <span class="nav-text">Register User</span>
                    </a>
                </li>
            </ul>

            <div class="sidebar-footer">
                <div class="system-status">
                    <div class="status-dot"></div>
                    <span>Sarasavi System Active</span>
                </div>
            </div>
        </aside>

        <!-- Main Content Area -->
        <main class="main-content">
            @RenderBody()
        </main>
    </div>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
