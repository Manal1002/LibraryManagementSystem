@page
@model BorrowModel
@{
    ViewData["Title"] = "Loan Book";
}

<!-- Page Header Bar -->
<div class="header-bar">
    <div class="page-title">
        <h1>Book Loan Process</h1>
        <p>Issue library book copies to Registered Members. The system will enforce copy-type restrictions, active loan count limits, and visitor blocks.</p>
    </div>
</div>

<!-- Notifications -->
@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="custom-alert success">
        <span class="custom-alert-icon">✓</span>
        <div class="custom-alert-content">
            <div class="custom-alert-title">Loan Confirmed</div>
            <div class="custom-alert-desc">@Model.SuccessMessage</div>
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="custom-alert danger">
        <span class="custom-alert-icon">⚠</span>
        <div class="custom-alert-content">
            <div class="custom-alert-title">Loan Authorization Failure</div>
            <div class="custom-alert-desc">@Model.ErrorMessage</div>
        </div>
    </div>
}

<div class="dashboard-grid" style="grid-template-columns: 1.5fr 1fr; gap: 2rem;">
    <!-- Form Panel -->
    <div class="glass-panel">
        <div class="section-header" style="margin-bottom: 2rem; border-bottom: 1px solid var(--panel-border); padding-bottom: 1rem;">
            <h2>Configure Loan Transaction</h2>
        </div>

        <form method="post">
            <div class="form-grid" style="grid-template-columns: 1fr;">
                <!-- Book Copy Number -->
                <div class="form-group">
                    <label asp-for="CopyNumber" class="form-label"></label>
                    <input asp-for="CopyNumber" class="form-control" placeholder="e.g. S0001-2" />
                    <span asp-validation-for="CopyNumber" style="color: var(--color-danger); font-size: 0.8rem;"></span>
                    <small style="color: var(--text-muted); margin-top: 0.25rem;">Enter the physical copy ID format (AccessionNumber-CopyNumber).</small>
                </div>

                <!-- Borrower Number -->
                <div class="form-group" style="margin-top: 1rem;">
                    <label asp-for="UserNumber" class="form-label"></label>
                    <input asp-for="UserNumber" class="form-control" placeholder="e.g. MEM0001" />
                    <span asp-validation-for="UserNumber" style="color: var(--color-danger); font-size: 0.8rem;"></span>
                    <small style="color: var(--text-muted); margin-top: 0.25rem;">Enter the unique library card identification number assigned to the member.</small>
                </div>
            </div>

            <div style="display: flex; justify-content: flex-end; gap: 1rem; border-top: 1px solid var(--panel-border); padding-top: 1.5rem; margin-top: 2rem;">
                <button type="reset" class="btn btn-secondary">Clear Fields</button>
                <button type="submit" class="btn btn-primary">
                    Confirm & Authorize Loan
                </button>
            </div>
        </form>
    </div>

    <!-- Loan Rules Advisory Panel -->
    <div class="glass-panel" style="background: rgba(168, 85, 247, 0.03); border-color: rgba(168, 85, 247, 0.1);">
        <div class="section-header" style="margin-bottom: 1.5rem; border-bottom: 1px solid rgba(255,255,255,0.05); padding-bottom: 0.5rem;">
            <h2 style="color: var(--color-secondary); font-size: 1.15rem;">Loan Criteria Advisory</h2>
        </div>

        <ul style="list-style: none; display: flex; flex-direction: column; gap: 1rem; font-size: 0.9rem; color: var(--text-secondary);">
            <li style="display: flex; align-items: flex-start; gap: 0.5rem;">
                <span style="color: var(--color-secondary); font-weight: bold;">■</span>
                <div>
                    <strong>Maximum active loan count:</strong> Members are restricted to a maximum of 5 concurrent book borrowings at any single time.
                </div>
            </li>
            <li style="display: flex; align-items: flex-start; gap: 0.5rem;">
                <span style="color: var(--color-secondary); font-weight: bold;">■</span>
                <div>
                    <strong>Visitor Borrowing Restriction:</strong> Only Registered Members hold borrowing credentials. Visitors are only permitted in-library reference.
                </div>
            </li>
            <li style="display: flex; align-items: flex-start; gap: 0.5rem;">
                <span style="color: var(--color-secondary); font-weight: bold;">■</span>
                <div>
                    <strong>Reference Copies:</strong> Any copy flagged as 'Reference Only' is non-borrowable and cannot leave library premises.
                </div>
            </li>
            <li style="display: flex; align-items: flex-start; gap: 0.5rem;">
                <span style="color: var(--color-secondary); font-weight: bold;">■</span>
                <div>
                    <strong>Loan Period:</strong> Authorized loans are stamped with an expected return timeframe of exactly **14 days (2 weeks)**.
                </div>
            </li>
        </ul>
    </div>
</div>
