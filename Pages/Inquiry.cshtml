@page
@model InquiryModel
@{
    ViewData["Title"] = "Book Inquiry";
}

<!-- Page Header Bar -->
<div class="header-bar">
    <div class="page-title">
        <h1>Sarasavi Book Inquiry</h1>
        <p>Perform real-time search by Title, Author, Publisher, Genre, or unique Accession Number to track copy availability.</p>
    </div>
</div>

<!-- Search Panel -->
<div class="glass-panel" style="padding: 1.5rem; margin-bottom: 2rem;">
    <form method="get" class="search-panel">
        <div class="search-input-wrapper">
            <svg class="search-icon" viewBox="0 0 24 24">
                <path d="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/>
            </svg>
            <input type="text" asp-for="SearchQuery" class="form-control search-control" placeholder="Search by Accession (e.g. S0001), Title, Author or Publisher..." />
        </div>
        <button type="submit" class="btn btn-primary">
            Search Catalog
        </button>
        @if (!string.IsNullOrWhiteSpace(Model.SearchQuery))
        {
            <a asp-page="/Inquiry" class="btn btn-secondary">Clear</a>
        }
    </form>
</div>

<!-- Results Grid -->
<div class="book-cards-grid">
    @if (Model.SearchResults.Count == 0)
    {
        <div class="glass-panel" style="grid-column: 1 / -1; text-align: center; padding: 4rem; color: var(--text-secondary);">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom: 1rem; opacity: 0.5;">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="8" y1="12" x2="16" y2="12"></line>
            </svg>
            <h3>No Books Found Matching Your Query</h3>
            <p style="margin-top: 0.5rem; color: var(--text-muted);">Please refine your search terms or register a new book title in the catalog.</p>
        </div>
    }
    else
    {
        foreach (var result in Model.SearchResults)
        {
            <div class="book-card">
                <div>
                    <!-- Card Top Header Info -->
                    <div class="book-header">
                        <span class="book-accession">@result.Book.AccessionNumber</span>
                        <span class="book-genre">@result.Book.Genre</span>
                    </div>

                    <!-- Book Info -->
                    <h3 class="book-title">@result.Book.Title</h3>
                    <div class="book-meta">
                        <div>By: <strong style="color: #fff;">@result.Book.Author</strong></div>
                        <small style="color: var(--text-muted);">Publisher: @result.Book.Publisher</small>
                    </div>
                </div>

                <div>
                    <!-- Quick Count Stats -->
                    <div class="book-stats">
                        <div>
                            <div class="book-stat-val" style="color: #fff;">@result.TotalCopies</div>
                            <div class="book-stat-lbl">Total</div>
                        </div>
                        <div>
                            <div class="book-stat-val" style="color: var(--color-primary);">@result.AvailableCopies</div>
                            <div class="book-stat-lbl">Available</div>
                        </div>
                        <div>
                            <div class="book-stat-val" style="color: var(--color-secondary);">@result.ReferenceCopies</div>
                            <div class="book-stat-lbl">Reference</div>
                        </div>
                    </div>

                    <!-- Individual Copies Tracking Details -->
                    <div class="copy-status-row">
                        <div class="copy-status-title">Individual Book Copies:</div>
                        <div class="copies-list">
                            @foreach (var copy in result.Book.Copies)
                            {
                                <span class="copy-pill @copy.Status">
                                    <strong>@copy.CopyNumber.Split('-').Last()</strong>: 
                                    @if (copy.IsReferenceOnly)
                                    {
                                        <span style="color: #64748b; font-weight: 700;">Ref</span>
                                    }
                                    else
                                    {
                                        <span>@copy.Status</span>
                                    }
                                </span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>
